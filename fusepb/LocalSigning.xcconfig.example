// Copy this file to LocalSigning.xcconfig for maintainer-only release signing.
// Do not commit LocalSigning.xcconfig.
// The top-level Makefile reads DEVELOPMENT_TEAM from this file and resolves
// the matching Developer ID Application certificate from the keychain.

CODE_SIGN_IDENTITY = Developer ID Application
DEVELOPMENT_TEAM = YOUR_TEAM_ID

// Staging-only updater wiring example:
// SPARKLE_FEED_URL = https://fmeunier.github.io/fuse-for-macos/appcast-staging.xml
// SPARKLE_PUBLIC_ED_KEY = <paste your Sparkle public key here>
SPARKLE_FEED_URL =
SPARKLE_PUBLIC_ED_KEY =
